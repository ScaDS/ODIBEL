{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scads.ai/kgi-bench/schemas/experiment.schema.json",
  "title": "KGI-Bench Integration Experiment Metadata",
  "description": "Join key from pipeline runs back to a provenance dataset_id.",
  "type": "object",
  "required": ["schema_version", "experiment_id", "dataset_id", "pipeline", "metrics"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "experiment_id": { "type": "string" },
    "dataset_id": {
      "type": "string",
      "description": "Foreign key into registry.json / dataset_card.dataset_id"
    },
    "pipeline": {
      "type": "object",
      "required": ["pipeline_id"],
      "properties": {
        "pipeline_id": { "type": "string" },
        "setting": { "type": "string", "enum": ["SSP", "MSP"] },
        "source_order": { "type": "array", "items": { "type": "string" } },
        "tool": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "description": "KGI-Bench coverage/correctness/consistency (and auxiliaries)"
    },
    "created_at": { "type": "string" },
    "notes": { "type": ["string", "null"] }
  }
}
